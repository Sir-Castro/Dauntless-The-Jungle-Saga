                                const item = nextEnemies.find(e => e.id === id);
                                if (item && item.hp > 0 && Math.max(0, item.hp - PROJECTILE_STATS.GRENADE_DAMAGE_THRESHOLD) === 0) {
                                    if (item.type.startsWith('z')) zombiesKilledThisExplosion++;
                                    if (item.type.startsWith('raider')) raidersKilledThisExplosion++;
                                }
