                                        return o;
                                    }));
                                }
                                if (raidersKilledThisExplosion >= 2) {
                                    setObjectives(obs => obs.map(o => {
                                        if (o.id === 2 && o.status === 'active') {
                                            const nextCount = (o.current || 0) + 1;
                                            return { ...o, current: nextCount, status: nextCount >= (o.target || 1) ? 'complete' : 'active' };
                                        }
                                        return o;
                                    }));
