                                        let increment = false;

                                        if (levelId === 5 && o.id === 1 && isRaider) increment = true;
                                        if (levelId === 7 && o.id === 1 && fromGrenade) increment = true;

                                        if (levelId === 9 && o.id === 1 && isRaider) increment = true;

                                        if (levelId === 10) {
                                            if (o.id === 1 && isRaider && fromZombMelee) increment = true;
                                            if (o.id === 2 && isZombie && fromGrenade) increment = true;
                                        }

                                        if (levelId === 11 && o.id === 2 && isRaider && fromPlayer) increment = true;
                                        if (levelId === 12 && o.id === 2 && isZombie && fromPlayer) increment = true;
                                        if (levelId === 16 && o.id === 1 && isRaider && fromPlayer) increment = true;
                                        if (levelId === 17 && o.id === 1 && isZombie && fromPlayer) increment = true;
                                        if (levelId === 19 && o.id === 2 && isRaider && fromPlayer) increment = true;
                                        if (levelId === 20 && o.id === 1 && (isZombie || isRaider) && fromPlayer) increment = true;

                                        if (increment) {
                                            const nextCount = (o.current || 0) + 1;
                                            const isDone = nextCount >= (o.target || 5);
                                            return { ...o, current: nextCount, status: isDone ? 'complete' : 'active' };
                                        }
                                        return o;
                                    });
                                });
                            }
                        }

                        e.hp = newHp;
                        e.state = newHp === 0 ? 'dead' : e.state;
                        e.frame = newHp === 0 ? 0 : e.frame;
                        e.hasDroppedAmmo = newHp === 0 && isRaider;
                        e.hurtFlashTicks = 13;
                        nextEnemies[eIndex] = e;
                    }
                    return false;
                }

                // Hazard Collision Solver: Detect hits on destructible hazards (t1 turrets)
                let hitHazardId = null;
                if (p.owner === 'player') {
                    (levelData.hazards || []).forEach(h => {
                        if (h.type === 'turret_top' && h.hp !== 0) {
                            const dx = Math.abs(p.x - (h.x + (h.w || 5) / 2));
                            const dy = Math.abs(p.y - (h.y + 10));
                            if (dx < 12 && dy < 15) {
                                hitHazardId = h.id;
                            }
                        }
                    });
                }

                if (hitHazardId !== null) {
                    const h = levelData.hazards.find(haz => haz.id === hitHazardId);
                    if (h) {
