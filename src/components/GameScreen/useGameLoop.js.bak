                    });

                    if (hitEnemyIds.length > 0) {
                        enemiesUpdated = true;

                        let zombiesKilledThisExplosion = 0;
                        let raidersKilledThisExplosion = 0;
                        if ([11, 12, 13, 14, 18].includes(levelId)) {
